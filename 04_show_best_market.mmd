flowchart TD
    s(["Start showBestMarket()"])
    i1[/"Input cropName and district"/]
    p1[["bestNet = getBestNetPrice(cropName, district)"]]
    d1{"lastBestMarket<br/>is empty?"}
    o1[/"Display<br/>'No price data available'"/]
    o2[/"Display lastBestMarket<br/>and bestNet per bag"/]
